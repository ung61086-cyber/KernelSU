        Font=Enum.Font.GothamBold,
        TextSize=10
    },f)
    New("UICorner",{CornerRadius=UDim.new(0,6)},b)
    b.Activated:Connect(callback)
    return b
end

local function Toggle(parent,title,callback)
    local f=New("Frame",{
        Size=UDim2.new(1,0,0,39),
        BackgroundColor3=C.BG
    },parent)
    New("UICorner",{CornerRadius=UDim.new(0,7)},f)

    New("TextLabel",{
        Position=UDim2.fromOffset(9,0),
        Size=UDim2.new(1,-70,1,0),
        BackgroundTransparency=1,
        Text=title,
        TextColor3=C.WHITE,
        Font=Enum.Font.GothamMedium,
        TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left
    },f)

    local state=false
    local b=New("TextButton",{
        Position=UDim2.new(1,-55,.5,-13),
        Size=UDim2.fromOffset(48,26),
        BackgroundColor3=C.GREY,
        Text="OFF",
        TextColor3=C.WHITE,
        Font=Enum.Font.GothamBold,
        TextSize=10
    },f)
    New("UICorner",{CornerRadius=UDim.new(1,0)},b)

    b.Activated:Connect(function()
        state=not state
        b.Text=state and "ON" or "OFF"
        b.BackgroundColor3=state and C.PURPLE or C.GREY
        if callback then callback(state) end
    end)
end

