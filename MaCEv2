Section(Combat,"COMBAT")

Action(Combat,"Mace Swap",function()
    local char=LP.Character
    local bag=LP:FindFirstChildOfClass("Backpack")
    local mace

    for _,container in ipairs({char,bag}) do
        if container then
            for _,tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:lower():find("mace") then
                    mace=tool
                    break
                end
            end
        end
        if mace then break end
    end

    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if mace and hum then
        hum:EquipTool(mace)
    end
end)

