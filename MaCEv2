local toggles = {}

local function toggle(parent, name, default, callback)
    local f = row(parent,name)
    local state = default or false
    local b = make("TextButton", {
        AnchorPoint=Vector2.new(1,.5),
        Position=UDim2.new(1,-5,.5,0),
        Size=UDim2.fromOffset(48,25),
        BackgroundColor3=state and Purple or Muted,
        Text=state and "ON" or "OFF",
        TextColor3=White,
        Font=Enum.Font.GothamBold,
        TextSize=10
    }, f)
    make("UICorner", {CornerRadius=UDim.new(1,0)}, b)
    local function set(v)
        state = v
        b.Text = v and "ON" or "OFF"
        b.BackgroundColor3 = v and Purple or Muted
        if callback then callback(v) end
    end
    b.Activated:Connect(function() set(not state) end)
    toggles[name] = set
    return function() return state end
end

local function slider(parent, name, min, max, default, callback)
    local f = make("Frame", {
        Size=UDim2.new(1,0,0,56),
        BackgroundColor3=Dark,
        BorderSizePixel=0
    }, parent)
    make("UICorner", {CornerRadius=UDim.new(0,7)}, f)
    local title = make("TextLabel", {
        Position=UDim2.fromOffset(9,3),
        Size=UDim2.new(1,-18,0,20),
        BackgroundTransparency=1,
        Text=name..": "..default,
        TextColor3=White,
        Font=Enum.Font.GothamBold,
        TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left
    }, f)
    local bar = make("TextButton", {
        Position=UDim2.fromOffset(10,32),
        Size=UDim2.new(1,-20,0,8),
        BackgroundColor3=Muted,
        Text=""
    }, f)
    make("UICorner", {CornerRadius=UDim.new(1,0)}, bar)
    local fill = make("Frame", {
        Size=UDim2.new((default-min)/(max-min),0,1,0),
        BackgroundColor3=Purple,
        BorderSizePixel=0
    }, bar)
    make("UICorner", {CornerRadius=UDim.new(1,0)}, fill)

    local value = default
    local function update(x)
        local pct = math.clamp(x,0,1)
        value = math.floor(min+pct*(max-min))
        fill.Size = UDim2.new(pct,0,1,0)
        title.Text = name..": "..value
        if callback then callback(value) end
    end
    bar.Activated:Connect(function()
        local mouseX = UIS:GetMouseLocation().X
        update((mouseX-bar.AbsolutePosition.X)/bar.AbsoluteSize.X)
    end)
    return function() return value end
end

